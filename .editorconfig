root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{csproj,props,json,config}]
indent_style = space
indent_size = 2

[*.ps1]
charset = utf-8-bom
indent_style = space
indent_size = 4
