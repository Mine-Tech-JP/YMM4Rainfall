<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../samples/pig-side-256.png" LogicalName="YMM4Rainfall.BuiltIn.Pig.png" />
    <EmbeddedResource Include="Fixtures/NewItemDefaults.json" />
    <Compile Include="../../src/YMM4Rainfall/*.cs" Link="Plugin/%(Filename)%(Extension)" />
    <AssemblyMetadata Include="YMM4ReferenceDirectory" Value="$(YMM4ReferenceDirectory)" />
    <Reference Include="YukkuriMovieMaker.Plugin;YukkuriMovieMaker.Controls;Newtonsoft.Json">
      <HintPath>$(YMM4ReferenceDirectory)%(Identity).dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="../../src/YMM4Rainfall/Simulation/*.cs" Link="Simulation/%(Filename)%(Extension)" />
    <Compile Include="../../src/YMM4Rainfall/Rendering/*.cs" Link="Rendering/%(Filename)%(Extension)" />
    <Reference Include="Vortice.Direct2D1;Vortice.Direct3D11;Vortice.DirectX;Vortice.DXGI;Vortice.Mathematics;SharpGen.Runtime;SharpGen.Runtime.COM">
      <HintPath>$(YMM4ReferenceDirectory)%(Identity).dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
